<!doctype html>
<html lang="en-us">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title>Unity Web Player | MAPAURPUVG</title>
    <link rel="shortcut icon" href="TemplateData/favicon.ico" />
    <link rel="stylesheet" href="TemplateData/style.css" />
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #1a1a1a;
      }
      #unity-container.unity-desktop {
        position: relative;
        width: 100%;
        height: 100%;
      }
      .unity-desktop #unity-canvas {
        width: 100%;
        height: 100%;
        display: block;
      }

      /* Floating fullscreen toggle drawn over the scene */
      #uvg-fs-toggle {
        position: absolute;
        top: 14px;
        right: 16px;
        z-index: 30;
        width: 44px;
        height: 44px;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        cursor: pointer;
        transition:
          background 0.15s ease,
          transform 0.15s ease;
      }
      #uvg-fs-toggle:hover {
        background: rgba(0, 0, 0, 0.8);
        transform: scale(1.08);
      }
      #uvg-fs-toggle svg {
        width: 20px;
        height: 20px;
        fill: #fff;
        pointer-events: none;
      }
      #uvg-fs-toggle .icon-exit {
        display: none;
      }
      #uvg-fs-toggle.is-fullscreen .icon-enter {
        display: none;
      }
      #uvg-fs-toggle.is-fullscreen .icon-exit {
        display: block;
      }
    </style>
  </head>
  <body>
    <div id="unity-container" class="unity-desktop">
      <canvas id="unity-canvas" tabindex="-1"></canvas>
      <div id="unity-loading-bar">
        <div id="unity-logo"></div>
        <div id="unity-progress-bar-empty">
          <div id="unity-progress-bar-full"></div>
        </div>
      </div>
      <div id="unity-warning"></div>
      <button id="uvg-fs-toggle" type="button" aria-label="Pantalla completa">
        <svg class="icon-enter" viewBox="0 0 24 24">
          <path
            d="M4 9V4h5v2H6v3H4zm0 6h2v3h3v2H4v-5zm14 0h2v5h-5v-2h3v-3zM15 6V4h5v5h-2V6h-3z"
          />
        </svg>
        <svg class="icon-exit" viewBox="0 0 24 24">
          <path
            d="M9 4h2v5H6V7h3V4zm4 0h2v3h3v2h-5V4zM6 15h5v5H9v-3H6v-2zm7 0h5v2h-3v3h-2v-5z"
          />
        </svg>
      </button>
    </div>
    <script>
      var canvas = document.querySelector("#unity-canvas");

      function unityShowBanner(msg, type) {
        var warningBanner = document.querySelector("#unity-warning");
        function updateBannerVisibility() {
          warningBanner.style.display = warningBanner.children.length
            ? "block"
            : "none";
        }
        var div = document.createElement("div");
        div.innerHTML = msg;
        warningBanner.appendChild(div);
        if (type == "error") div.style = "background: red; padding: 10px;";
        else {
          if (type == "warning")
            div.style = "background: yellow; padding: 10px;";
          setTimeout(function () {
            warningBanner.removeChild(div);
            updateBannerVisibility();
          }, 5000);
        }
        updateBannerVisibility();
      }

      var buildUrl = "Build";
      var loaderUrl = buildUrl + "/MapaUVGPart2.loader.js";
      var config = {
        arguments: [],
        dataUrl: buildUrl + "/MapaUVGPart2.data",
        frameworkUrl: buildUrl + "/MapaUVGPart2.framework.js",
        codeUrl: buildUrl + "/MapaUVGPart2.wasm",
        streamingAssetsUrl: "StreamingAssets",
        companyName: "DefaultCompany",
        productName: "MAPAURPUVG",
        productVersion: "0.1",
        showBanner: unityShowBanner,
        webGLContextAttributes: {
          powerPreference: "high-performance",
        },
      };

      // The canvas fills its container instead of the template's fixed
      // 1920x1080 box, so on a large screen at dpr 2 it would render ~7x the
      // pixels the default template did — that is the FPS drop. Cap the
      // render target to a fixed pixel budget: the canvas still fills the
      // window, it just doesn't rasterize more than ~1920x1080 worth of it.
      var MAX_RENDER_PIXELS = 2400 * 1350; // ~3.24M, a bit above 1080p

      function computeDevicePixelRatio() {
        // Measure the CSS viewport only. Do NOT fold in screen.width/height:
        // on Android those report the physical panel, which inflates the area
        // and drives the ratio below 1, making the browser upscale a
        // too-small render target (blurry text).
        var w = window.innerWidth || 1920;
        var h = window.innerHeight || 1080;
        var dpr = window.devicePixelRatio || 1;

        if (w * h * dpr * dpr > MAX_RENDER_PIXELS) {
          dpr = Math.sqrt(MAX_RENDER_PIXELS / (w * h));
        }

        // Never go below 1: at less than 1 CSS pixel per rendered pixel the
        // result is always visibly soft. Cap at 2 — beyond that the extra
        // fill-rate buys almost nothing on a phone-sized panel.
        return Math.max(1, Math.min(dpr, 2));
      }

      config.devicePixelRatio = computeDevicePixelRatio();

      var isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);

      if (isMobile) {
        var meta = document.createElement("meta");
        meta.name = "viewport";
        meta.content =
          "width=device-width, height=device-height, initial-scale=1.0, user-scalable=no, shrink-to-fit=yes";
        document.getElementsByTagName("head")[0].appendChild(meta);
        document.querySelector("#unity-container").className = "unity-mobile";
        canvas.className = "unity-mobile";
      }
      // Desktop keeps the CSS above: canvas fills its container (the parent
      // iframe) instead of being pinned to a fixed 1920x1080 box.

      document.querySelector("#unity-loading-bar").style.display = "block";

      // --- Fullscreen toggle -------------------------------------------------
      // Uses the browser Fullscreen API on the container (not Unity's
      // SetFullscreen) so the HTML button stays drawn on top of the scene and
      // can be clicked to exit again.
      var fsToggle = document.querySelector("#uvg-fs-toggle");
      var fsTarget = document.querySelector("#unity-container");

      function fsElement() {
        return (
          document.fullscreenElement ||
          document.webkitFullscreenElement ||
          document.mozFullScreenElement ||
          document.msFullscreenElement
        );
      }

      function enterFs() {
        var fn =
          fsTarget.requestFullscreen ||
          fsTarget.webkitRequestFullscreen ||
          fsTarget.mozRequestFullScreen ||
          fsTarget.msRequestFullscreen;
        if (!fn) return;
        try {
          var p = fn.call(fsTarget);
          if (p && typeof p.catch === "function") p.catch(function () {});
        } catch (e) {}
      }

      function exitFs() {
        var fn =
          document.exitFullscreen ||
          document.webkitExitFullscreen ||
          document.mozCancelFullScreen ||
          document.msExitFullscreen;
        if (!fn) return;
        try {
          var p = fn.call(document);
          if (p && typeof p.catch === "function") p.catch(function () {});
        } catch (e) {}
      }

      fsToggle.addEventListener("click", function () {
        if (fsElement()) exitFs();
        else enterFs();
      });

      // Keep the icon in sync however fullscreen was entered or left (Esc,
      // browser UI, the parent page's overlay, etc).
      [
        "fullscreenchange",
        "webkitfullscreenchange",
        "mozfullscreenchange",
        "MSFullscreenChange",
      ].forEach(function (evt) {
        document.addEventListener(evt, function () {
          var active = !!fsElement();
          fsToggle.classList.toggle("is-fullscreen", active);
          fsToggle.setAttribute(
            "aria-label",
            active ? "Salir de pantalla completa" : "Pantalla completa",
          );
          // Nudge Unity to resync the canvas after the transition.
          setTimeout(function () {
            window.dispatchEvent(new Event("resize"));
          }, 150);
          setTimeout(function () {
            window.dispatchEvent(new Event("resize"));
          }, 400);
        });
      });

      var script = document.createElement("script");
      script.src = loaderUrl;
      script.onload = () => {
        createUnityInstance(canvas, config, (progress) => {
          document.querySelector("#unity-progress-bar-full").style.width =
            100 * progress + "%";
        })
          .then((unityInstance) => {
            document.querySelector("#unity-loading-bar").style.display = "none";
            fsToggle.style.display = "flex";
          })
          .catch((message) => {
            alert(message);
          });
      };

      document.body.appendChild(script);
    </script>
  </body>
</html>
